# Copy to .env and fill in. Get a free key at build.nvidia.com
NVIDIA_API_KEY=nvapi-...

# Current model IDs; connection checked live on 2026-11-07.
NEMOTRON_NANO_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# With reasoning on, Nemotron can use 8k tokens just thinking; give it room
LLM_MAX_TOKENS=16384
LLM_TIMEOUT=120
# Disable reasoning by default to reserve the response budget for the answer.
NEMOTRON_THINKING=0

# Optional
# NVIDIA_BASE_URL=http://localhost:8000/v1   # local vLLM / Ollama instead of hosted
# LLM_MODE=fake                              # stub run, no API calls
# LLM_CACHE=0                                # disable response cache
# MAX_ATTEMPTS=3                             # rewrite retries per module
